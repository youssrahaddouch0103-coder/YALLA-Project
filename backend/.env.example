# Copy this file to .env and adjust the values to your MySQL setup
PORT=3000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=yalla_db
JWT_SECRET=change-me-to-a-long-random-string

# Hosting (e.g. TiDB Cloud): encrypted connection, create the tables on first start
DB_SSL=false
DB_AUTO_INIT=false
